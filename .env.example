# Copy this to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...

# API server (python -m englo.api)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Mobile app — set to your machine's LAN IP so Expo can reach the API
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Optional overrides
WHISPER_MODEL=base          # tiny | base | small | medium
TUTOR_LLM_MODEL=claude-haiku-4-5-20251001
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
RECORD_SECONDS=7            # max mic recording duration per turn

# Optional: Azure Pronunciation Assessment (cloud, superior phoneme scores)
# Leave blank to use the local Whisper-based scorer instead
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=        # e.g. eastus
